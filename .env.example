# 개발 기본값은 SQLite. PostgreSQL을 쓰려면 docker compose up -d 후 아래 줄로 교체
DATABASE_URL=sqlite:///./roadpush.db
# DATABASE_URL=postgresql+psycopg://roadpush:roadpush@localhost:5432/roadpush

# 원본·mask·overlay 저장 위치 (DB에는 저장 키만 기록)
STORAGE_DIR=./storage

# 노면 모델: dummy(모델 없이 흐름 확인) | selectstar(SelectStar DeepLab v3+) | hf(HuggingFace 비교 모델)
SURFACE_MODEL=dummy
SURFACE_WEIGHTS=model_weights/selectstar_deeplab.pt
# SURFACE_MODEL=hf
# SURFACE_WEIGHTS=facebook/mask2former-swin-tiny-cityscapes-semantic

# 장애물 모델: none | yolo
OBSTACLE_MODEL=none
# OBSTACLE_WEIGHTS=["model_weights/yolo11n-seg.pt","model_weights/yoloe-26s-seg.pt|traffic cone,barricade,construction fence,kick scooter,box,trash bag,signboard"]

DEVICE=cuda
INFER_SHORT_SIDE=768

# true면 API 프로세스 안에서 분석 워커 스레드를 띄운다 (노트북 한 대 데모용)
RUN_WORKER_IN_API=true

# 구간 후보 검색 반경(m). 실제 GPS 오차·구간 간격을 보고 정한다
SITE_SEARCH_RADIUS_M=50

# 프론트 주소 (배포하면 테스트 URL도 추가)
CORS_ORIGINS=["http://localhost:5173"]
