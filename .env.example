# 팀원 로컬 개발: SQLite 그대로 (사진이 각자 PC에 저장되므로 공용 DB에 붙지 않는다)
DATABASE_URL=sqlite:///./data/roadpush.db
# 배포 서버만: Supabase Session pooler 주소 (docs/DB.md 2장)
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<비밀번호>@<pooler 호스트>.pooler.supabase.com:5432/postgres?sslmode=require
# 로컬 PostgreSQL로 시험할 때: docker compose up -d
# DATABASE_URL=postgresql+psycopg://roadpush:roadpush@localhost:5432/roadpush

# 원본·mask·overlay 저장 위치 (DB에는 저장 키만 기록)
STORAGE_DIR=./storage

# 분석 엔진: dummy(모델 없이 흐름 확인. 심사용 결과로 쓰지 않음) | roadpush_ai(RoadPush_AI 팀 파이프라인)
ANALYSIS_ENGINE=dummy
# ── 아래는 ANALYSIS_ENGINE=roadpush_ai일 때 (Python 3.12, docs/SETUP.md 8장) ──
# RoadPush_AI 저장소 폴더 (src/roadpush_ai, surface_passability/src, configs/). 통합 RoadPushAnalyzer를 쓴다
# ROADPUSH_AI_ROOT=../RoadPush_AI
# AI 모델 폴더 (Git 제외): surface_passability/semantic/, surface_passability/yolo11n-seg.pt,
#   obstacle_detection/obstacle_yolo11s_full_os4.pt. 비우면 ROADPUSH_AI_ROOT/models
# ROADPUSH_MODEL_ROOT=
# Mask2Former 장치. AI 팀 결과 재현 기준은 cpu (cuda는 빠르지만 결과가 조금 달라질 수 있음)
# SEMANTIC_DEVICE=cpu
# 장애물 원인 모델 장치: auto | cuda | cpu
DEVICE=auto
# 7-B 실폭 판정(선택): 구간 보도 폭(sites.sidewalk_width_m)이 있을 때 통행 폭·안전 계수로 m 단위 판정
# 비우면 상대폭 기준(통과 ≥ 60%, 단절 < 30%)으로 나눈다
# AGENT_WIDTH_M=0.9
# SAFETY_FACTOR=1.2

# true면 API 프로세스 안에서 분석 워커 스레드를 띄운다 (노트북 한 대 데모용)
RUN_WORKER_IN_API=true

# 구간 후보 검색 반경(m). 실제 GPS 오차·구간 간격을 보고 정한다
SITE_SEARCH_RADIUS_M=50

# 행정구역·주소 자동 채우기 (브이월드 역지오코딩). 프론트 .env의 VWORLD_KEY와 같은 키를 써도 된다
# 비워 두면 등록 때 넣은 area·addr만 표시. 이미 등록한 관측은 python scripts/geocode_observations.py
VWORLD_KEY=
# VWORLD_DOMAIN=http://localhost:5173   # 배포 서버: https://road-push-fe.vercel.app (인증키에 등록한 서비스 URL)

# 배포용 CCTV 프록시 (/api/utic/player, /api/its/*). 프론트 .env와 같은 키. 로컬 개발에서는 프론트 개발 서버가 처리하므로 비워도 됨
# UTIC는 등록한 IP 대역에서만 응답한다 → 이 서버의 공인 IP를 UTIC에 등록
UTIC_API_KEY=
ITS_API_KEY=

# 참조 레이어(서울 보행 링크, docs/DB.md 6장). 테이블이 없으면 쓰지 않음
# REF_MATCH_MAX_M=20
# REF_WIDTH_SOURCES=["building_no"]

# 배포 서버만: 응답의 사진·overlay 주소 앞부분 (HTTPS 주소. docs/DEPLOY.md)
# PUBLIC_BASE_URL=https://1-2-3-4.sslip.io

# 이 백엔드를 호출할 수 있는 프론트 주소 (개발 서버 + Vercel 배포. Vercel 미리보기 주소는 CORS_ORIGIN_REGEX로 허용)
CORS_ORIGINS=["http://localhost:5173","https://road-push-fe.vercel.app"]
