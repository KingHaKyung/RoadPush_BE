# /etc/systemd/system/roadpush.service — 서버가 재부팅돼도 백엔드를 자동으로 다시 띄운다
[Unit]
Description=RoadPush backend
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/RoadPush_BE
# Ultralytics 설정 파일을 작업 폴더(Ultralytics/)가 아닌 홈에 두고, CPU 추론 스레드를 OCPU 수에 맞춘다
Environment=YOLO_CONFIG_DIR=/home/ubuntu/.config/Ultralytics
Environment=OMP_NUM_THREADS=4
# 분석 워커가 API 프로세스 안에서 돌기 때문에 uvicorn 워커는 1개
ExecStart=/home/ubuntu/RoadPush_BE/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
